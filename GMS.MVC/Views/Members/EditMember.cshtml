@model MemberToUpdateDTO

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-details border-0 p-2 shadow">
                <div class="card-body text-center">
                    <div class="text-center mt-3">
                        <img src="~/images/User.png" alt="@Model.Name" class="rounded-circle"
                             style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #fff; margin-top: -60px;" />
                    </div>
                    <div class="card-body text-center">
                        <h2 class="mb-1 text-primary-color">@Model.Name</h2>

                        <form method="post" asp-action="EditMember">
                            <div class="mt-4 text-start">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="Email" class="text-muted d-block mb-1"></label>
                                            <input asp-for="Email" class="form-control" />
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="Name" class="text-muted d-block mb-1"></label>
                                            <input asp-for="Name" class="form-control" />
                                            <span asp-validation-for="Name" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="Phone" class="text-muted d-block mb-1"></label>
                                            <input asp-for="Phone" class="form-control" />
                                            <span asp-validation-for="Phone" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="BuildingNumber" class="text-muted d-block mb-1"></label>
                                            <input asp-for="BuildingNumber" class="form-control" />
                                            <span asp-validation-for="BuildingNumber"
                                                  class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="City" class="text-muted d-block mb-1"></label>
                                            <input asp-for="City" class="form-control" />
                                            <span asp-validation-for="City" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="Street" class="text-muted d-block mb-1"></label>
                                            <input asp-for="Street" class="form-control" />
                                            <span asp-validation-for="Street" class="text-danger"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="HealthRecordDTO.Height" class="text-muted d-block mb-1"></label>
                                            <input asp-for="HealthRecordDTO.Height" class="form-control" />
                                            <span asp-validation-for="HealthRecordDTO.Height" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="HealthRecordDTO.Weight" class="text-muted d-block mb-1"></label>
                                            <input asp-for="HealthRecordDTO.Weight" class="form-control" />
                                            <span asp-validation-for="HealthRecordDTO.Weight" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="HealthRecordDTO.BloodType" class="form-label"></label>
                                            <select asp-for="HealthRecordDTO.BloodType" asp-items="Html.GetEnumSelectList<BloodType>()" class="form-select">
                                                <option value=""> -- Select BloodType -- </option>
                                            </select>
                                            <span asp-validation-for="HealthRecordDTO.BloodType" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded">
                                            <label asp-for="HealthRecordDTO.Note" class="text-muted d-block mb-1"></label>
                                            <input asp-for="HealthRecordDTO.Note" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="d-flex justify-content-between gap-2 mt-3 px-3 pb-3">
                                <a asp-controller="Members" asp-action="Index" class="btn btn-fill "> Back to List </a>
                                <button type="submit" class="btn btn-fill ">Done</button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {   
    <partial name="_ValidationScriptsPartial" />
}

